@startuml Frontend

!include style.puml

title Frontend data flow

rectangle "Backend (Python)\ncompile() -> JSON" as backend
rectangle "Viewer (source/frontend/index.html)\nvanilla JavaScript" as viewer
rectangle "Scene (three.js)\nshaders bloch.vert + bloch.frag\ninstanced chain of Bloch spheres" as scene
rectangle "Panels\nhealth, details, p(|1), frames" as panels

backend -down-> viewer : JSON text
viewer -down-> scene : instancePsi, iTime
viewer -down-> panels : fields of the step

rectangle "Qollab build\nmake qollab" as qollab
qollab .down.> viewer : reuses, does not rewrite

@enduml
