@startuml Modules

!include style.puml

title Modules

package "backend" {

    package "core" {
        [model.py]
        [errors.py]
        [config.py]
        [constants.py]
        [to_qiskit.py]

        package "provider" {
            [provider.py]
            [profiles.py]
        }
        package "compiler" {
            [compiler.py]
        }
        package "transpiler" {
            [transpiler.py]
        }
        package "translator" {
            [translator.py]
            [rules.py]
            [normalize.py]
        }
        package "simulator" {
            [simulator.py]
            [gpi.py]
            [gpi2.py]
            [ms.py]
            [zz.py]
            [virtualz.py]
            [tomography.py]
        }
        package "vectorizer" {
            [vectorizer.py]
        }
        package "metrics" {
            [metrics.py]
        }
        package "formatter" {
            [formatter.py]
        }
        package "exporter" {
            [exporter.py]
        }
    }
}

package "scripts" {
    [demo_*.py]
}

@enduml
