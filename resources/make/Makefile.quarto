# Build the Quarto book that lives in the documentation folder.
#
# The project root (this repository) is the working directory, so every recipe
# enters `$(DOCS)` before calling Quarto. The file `documentation/_quarto.yml`
# configures the book.

QUARTO ?= quarto
DOCS ?= documentation
PREVIEW_PORT ?= 4321
PREVIEW_ARGS ?= --no-browser --port $(PREVIEW_PORT)

.PHONY: all render html pdf-typst preview check clean help

all: render

## render: render every format configured in documentation/_quarto.yml
render:
	cd $(DOCS) && $(QUARTO) render

## html: render the HTML book only
html:
	cd $(DOCS) && $(QUARTO) render --to html

## pdf-typst: render the PDF with Typst
pdf-typst:
	cd $(DOCS) && $(QUARTO) render --to typst

## preview: serve the book and re-render changed chapters on save
preview:
	cd $(DOCS) && $(QUARTO) preview $(PREVIEW_ARGS)

## check: verify the Quarto toolchain
check:
	$(QUARTO) check

## clean: remove all the build output of the documentation
clean:
	rm -rf $(DOCS)/_book $(DOCS)/.quarto
	find $(DOCS) -name '.jupyter_cache' -type d -prune -exec rm -rf {} +
	find $(DOCS) -name '*_files' -type d -prune -exec rm -rf {} +

## help: list available targets
help:
	@grep -h -E '^## ' $(MAKEFILE_LIST) | sed 's/^## //'

# A single chapter can also be rendered directly, for example:
# quarto render documentation/docs/index.qmd
