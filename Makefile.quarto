QUARTO ?= quarto
PYTHON ?= python3
PREVIEW_PORT ?= 4321
PREVIEW_ARGS ?= --no-browser --port $(PREVIEW_PORT)

.PHONY: all render html pdf preview check clean help crosswords

all: render

## render: render every format configured in _quarto.yml
render:
	$(QUARTO) render

## html: render the web/PDF-prep output only
html:
	$(QUARTO) render --to html

## pdf-latex: render the LaTeX PDF (not recommended).
pdf-latex:
	$(QUARTO) render --to pdf

## pdf-typst: render the Typst PDF (highly recommended).
pdf-typst:
	$(QUARTO) render --to typst

## preview: serve the book and re-render changed chapters on save
preview:
	$(QUARTO) preview $(PREVIEW_ARGS)

## check: verify the Quarto/Python toolchain
check:
	$(QUARTO) check

## clean: remove all build output
clean:
	rm -rf _book .quarto
	find . -name '.jupyter_cache' -type d -prune -exec rm -rf {} +
	find . -name '*_files' -type d -prune -exec rm -rf {} +

## help: list available targets
help:
	@grep -E '^## ' $(MAKEFILE_LIST) | sed 's/^## //'

# Specific file:
# quarto render path/to/file.qmd